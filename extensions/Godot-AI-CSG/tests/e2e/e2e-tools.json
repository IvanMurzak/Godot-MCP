{
  "description": "Live E2E for the CSG RQL module. Driven by scripts/extension_e2e.py (via scripts/extension_live.py) against ONE connected headless editor and a local gamedev-mcp-server. The module ships no MCP tools: every call is the core rql-query / rql-mutate / rql-schema, and a regression in the module (adapters, validation, guide) turns the suite red.",
  "notes": "The 'setup' opens a fresh scene (root Node3D 'Root') with the core editor | call NewScene. rql-schema proves the module was discovered (its adapter description). The 'tools' then run every CsgGuide example in order (the xUnit suite asserts this list contains them all, in order, each with rql-mutate for set / call and rql-query otherwise), followed by read-backs and rejected writes. 'expect' substrings are matched against the default compact RQL text inside godot-cli's --raw JSON: rows are '|'-separated. Refs and class use Godot's names (CSGBox3D#…, class CSGBox3D).",
  "setup": [
    {
      "tool": "rql-mutate",
      "input": {
        "query": "editor | call NewScene(\"res://e2e_csg.tscn\", \"Node3D\", \"Root\")"
      },
      "expect": [
        "NewScene"
      ]
    }
  ],
  "tools": [
    {
      "tool": "rql-schema",
      "input": {
        "type": "CSGSphere3D"
      },
      "expect": [
        "(CSG extension)",
        "RadialSegments",
        "rootShape"
      ]
    },
    {
      "tool": "rql-mutate",
      "input": {
        "query": "root | call AddChild(\"CSGCombiner3D\", \"Combo\")"
      },
      "expect": [
        "CSGCombiner3D#",
        "(Combo)"
      ]
    },
    {
      "tool": "rql-mutate",
      "input": {
        "query": "nodes | where name == \"Combo\" | call AddChild(\"CSGBox3D\", \"Box\")"
      },
      "expect": [
        "CSGBox3D#",
        "(Box)"
      ]
    },
    {
      "tool": "rql-mutate",
      "input": {
        "query": "nodes | where name == \"Box\" | set Size = \"(3, 3, 3)\""
      },
      "expect": [
        "Size|"
      ]
    },
    {
      "tool": "rql-mutate",
      "input": {
        "query": "nodes | where name == \"Combo\" | call AddChild(\"CSGSphere3D\", \"Ball\")"
      },
      "expect": [
        "CSGSphere3D#",
        "(Ball)"
      ]
    },
    {
      "tool": "rql-mutate",
      "input": {
        "query": "nodes | where name == \"Ball\" | set Radius = 1.8, RadialSegments = 16, Rings = 8, Operation = \"Subtraction\""
      },
      "expect": [
        "RadialSegments|",
        "Operation|"
      ]
    },
    {
      "tool": "rql-mutate",
      "input": {
        "query": "nodes | where name == \"Combo\" | call AddChild(\"CSGCylinder3D\", \"Pipe\")"
      },
      "expect": [
        "CSGCylinder3D#",
        "(Pipe)"
      ]
    },
    {
      "tool": "rql-mutate",
      "input": {
        "query": "nodes | where name == \"Pipe\" | set Radius = 0.5, Height = 4, Sides = 12, Operation = \"Union\""
      },
      "expect": [
        "Sides|"
      ]
    },
    {
      "tool": "rql-query",
      "input": {
        "query": "nodes | where $ is CSGShape3D | select name class Operation rootShape"
      },
      "expect": [
        "Combo|CSGCombiner3D|Union|true",
        "Ball|CSGSphere3D|Subtraction|false",
        "Pipe|CSGCylinder3D|Union|false"
      ]
    },
    {
      "tool": "rql-query",
      "input": {
        "query": "nodes | where name == \"Ball\" | select Radius RadialSegments Rings"
      },
      "expect": [
        "1.8|16|8"
      ]
    },
    {
      "tool": "rql-query",
      "input": {
        "query": "nodes | where name == \"Box\" | select Size.X Size.Y Size.Z"
      },
      "expect": [
        "3|3|3"
      ]
    },
    {
      "tool": "rql-mutate",
      "input": {
        "query": "nodes | where name == \"Ball\" | set RadialSegments = 2",
        "dry_run": true
      },
      "expect": [
        "RadialSegments must be at least 4 (got 2)"
      ],
      "expectFailure": true
    },
    {
      "tool": "rql-mutate",
      "input": {
        "query": "nodes | where name == \"Box\" | set Size = \"(3, 0, 3)\"",
        "dry_run": true
      },
      "expect": [
        "Size must be above 0 on every axis"
      ],
      "expectFailure": true
    },
    {
      "tool": "rql-mutate",
      "input": {
        "query": "nodes | where name == \"Pipe\" | set Height = 0",
        "dry_run": true
      },
      "expect": [
        "Height must be above 0"
      ],
      "expectFailure": true
    },
    {
      "tool": "rql-mutate",
      "input": {
        "query": "root | call AddChild(\"CSGTorus3D\", \"Ring\")"
      },
      "expect": [
        "CSGTorus3D#",
        "(Ring)"
      ]
    },
    {
      "tool": "rql-mutate",
      "input": {
        "query": "nodes | where name == \"Ring\" | set Sides = 2",
        "dry_run": true
      },
      "expect": [
        "Sides must be at least 3 (got 2)"
      ],
      "expectFailure": true
    },
    {
      "tool": "rql-query",
      "input": {
        "query": "nodes | where name == \"Pipe\" | select Height Sides"
      },
      "expect": [
        "4|12"
      ]
    }
  ]
}

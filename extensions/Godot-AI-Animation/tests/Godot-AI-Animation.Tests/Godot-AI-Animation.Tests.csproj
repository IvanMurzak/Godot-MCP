<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit-test project for the Animation RQL module. A PLAIN xUnit assembly (Microsoft.NET.Sdk), NOT a Godot game
    project — so it builds + runs in CI with no Godot binary.

    It compiles the module sources directly (no ProjectReference to the Godot.NET.Sdk package project), with TOOLS
    defined so the #if TOOLS module and adapters compile too. Only managed metadata is exercised: the RQL engine
    configures the module and builds the member tables of the Godot types by reflection; no Godot object is ever
    created (native-backed objects crash a plain test host). Writing to live animations is verified by the headless-Godot
    E2E (tests/e2e/e2e-tools.json), which runs every guide example.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>com.IvanMurzak.Godot.MCP.Animation.Tests</RootNamespace>
    <AssemblyName>com.IvanMurzak.Godot.MCP.Animation.Tests</AssemblyName>
    <DefineConstants>$(DefineConstants);TOOLS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- The package's RQL pin (IRqlModule, adapters, the parser for the guide examples) and the Godot API it
         compiles against (metadata only here). -->
    <PackageReference Include="com.IvanMurzak.Rql" Version="0.3.0-dev.c5fed20" />
    <PackageReference Include="GodotSharp" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Godot-AI-Animation\Editor\Rql\*.cs" Link="Source\%(Filename)%(Extension)" />
    <!-- The guide checks every extension shares (one copy per test assembly). -->
    <Compile Include="..\..\..\Shared\Tests\*.cs" Link="Shared\%(Filename)%(Extension)" />
    <None Include="..\e2e\e2e-tools.json" Link="e2e-tools.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

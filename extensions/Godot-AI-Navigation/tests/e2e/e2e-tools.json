{
  "description": "Live E2E for the Navigation RQL module. Driven by tests/e2e/run_tool_e2e.py (scripts/extension_live.py) against ONE connected headless editor and a local gamedev-mcp-server. The module ships no MCP tools: every call is the core rql-query / rql-mutate / rql-schema, and a regression in the module (adapters, validation, Bake, guide) turns the suite red.",
  "notes": "The 'setup' opens a fresh scene (root Node3D 'Root') with the core editor | call NewScene. rql-schema proves the module was discovered (its adapter description). The 'tools' then run every NavigationGuide example in order (the xUnit suite asserts this list contains them all, in order, each with rql-mutate for set / call and rql-query otherwise), followed by read-backs, rejected writes, a bake without a mesh, and the 2D region / agent (a NavigationRegion2D under the Node3D root: enough for the bake, which parses the region's own subtree). 'expect' substrings are matched against the default compact RQL text inside godot-cli's --raw JSON: rows are '|'-separated.",
  "setup": [
    {
      "tool": "rql-mutate",
      "input": {
        "query": "editor | call NewScene(\"res://e2e_navigation.tscn\", \"Node3D\", \"Root\")"
      },
      "expect": [
        "NewScene"
      ]
    }
  ],
  "tools": [
    {
      "tool": "rql-schema",
      "input": {
        "type": "NavigationRegion3D"
      },
      "expect": [
        "(Navigation extension)",
        "polygonCount",
        "Bake"
      ]
    },
    {
      "tool": "rql-mutate",
      "input": {
        "query": "root | call AddChild(\"NavigationRegion3D\", \"NavRegion\")"
      },
      "expect": [
        "NavigationRegion3D#",
        "(NavRegion)"
      ]
    },
    {
      "tool": "rql-mutate",
      "input": {
        "query": "nodes | where name == \"NavRegion\" | set NavigationMesh = {\"$type\": \"NavigationMesh\"}"
      },
      "expect": [
        "NavigationMesh#"
      ]
    },
    {
      "tool": "rql-mutate",
      "input": {
        "query": "nodes | where name == \"NavRegion\" | set NavigationMesh.GeometryParsedGeometryType = \"StaticColliders\", NavigationMesh.AgentRadius = 0.5"
      },
      "expect": [
        "StaticColliders"
      ]
    },
    {
      "tool": "rql-mutate",
      "input": {
        "query": "nodes | where name == \"NavRegion\" | call AddChild(\"StaticBody3D\", \"Floor\")"
      },
      "expect": [
        "StaticBody3D#",
        "(Floor)"
      ]
    },
    {
      "tool": "rql-mutate",
      "input": {
        "query": "nodes | where name == \"Floor\" | call AddChild(\"CollisionShape3D\", \"FloorShape\")"
      },
      "expect": [
        "CollisionShape3D#",
        "(FloorShape)"
      ]
    },
    {
      "tool": "rql-mutate",
      "input": {
        "query": "nodes | where name == \"FloorShape\" | set Shape = {\"$type\": \"BoxShape3D\", \"Size\": \"(10, 1, 10)\"}"
      },
      "expect": [
        "BoxShape3D#"
      ]
    },
    {
      "tool": "rql-mutate",
      "input": {
        "query": "nodes | where name == \"NavRegion\" | call Bake()"
      },
      "expect": [
        "Bake("
      ]
    },
    {
      "tool": "rql-query",
      "input": {
        "query": "nodes | where $ is NavigationRegion3D | select name Enabled polygonCount NavigationMesh"
      },
      "expect": [
        "NavRegion|true|",
        "NavigationMesh#"
      ]
    },
    {
      "tool": "rql-mutate",
      "input": {
        "query": "root | call AddChild(\"NavigationAgent3D\", \"NavAgent\")"
      },
      "expect": [
        "NavigationAgent3D#",
        "(NavAgent)"
      ]
    },
    {
      "tool": "rql-mutate",
      "input": {
        "query": "nodes | where name == \"NavAgent\" | set Radius = 0.75, MaxSpeed = 8, PathDesiredDistance = 1, TargetDesiredDistance = 1, AvoidanceEnabled = true"
      },
      "expect": [
        "Radius|",
        "AvoidanceEnabled|"
      ]
    },
    {
      "tool": "rql-mutate",
      "input": {
        "query": "root | call AddChild(\"NavigationLink3D\", \"NavLink\")"
      },
      "expect": [
        "NavigationLink3D#",
        "(NavLink)"
      ]
    },
    {
      "tool": "rql-mutate",
      "input": {
        "query": "nodes | where name == \"NavLink\" | set StartPosition = \"(0, 0, 0)\", EndPosition = \"(5, 0, 0)\", Bidirectional = true"
      },
      "expect": [
        "EndPosition|"
      ]
    },
    {
      "tool": "rql-query",
      "input": {
        "query": "nodes | where $ is NavigationAgent3D | select name Radius MaxSpeed PathDesiredDistance AvoidanceEnabled"
      },
      "expect": [
        "NavAgent|0.75|8|1|true"
      ]
    },
    {
      "tool": "rql-query",
      "input": {
        "query": "nodes | where name == \"NavRegion\" and polygonCount > 0 | select name NavigationMesh.GeometryParsedGeometryType"
      },
      "expect": [
        "1 result",
        "NavRegion|StaticColliders"
      ]
    },
    {
      "tool": "rql-query",
      "input": {
        "query": "nodes | where name == \"NavLink\" | select EndPosition Bidirectional"
      },
      "expect": [
        "(5, 0, 0)|true"
      ]
    },
    {
      "tool": "rql-mutate",
      "input": {
        "query": "nodes | where name == \"NavAgent\" | set Radius = 0",
        "dry_run": true
      },
      "expect": [
        "Radius must be above 0 (got 0)"
      ],
      "expectFailure": true
    },
    {
      "tool": "rql-mutate",
      "input": {
        "query": "nodes | where name == \"NavAgent\" | set AvoidancePriority = 2",
        "dry_run": true
      },
      "expect": [
        "AvoidancePriority must be between 0 and 1"
      ],
      "expectFailure": true
    },
    {
      "tool": "rql-mutate",
      "input": {
        "query": "nodes | where name == \"NavLink\" | set TravelCost = -1",
        "dry_run": true
      },
      "expect": [
        "TravelCost must be 0 or more"
      ],
      "expectFailure": true
    },
    {
      "tool": "rql-mutate",
      "input": {
        "query": "root | call AddChild(\"NavigationRegion3D\", \"EmptyRegion\")"
      },
      "expect": [
        "(EmptyRegion)"
      ]
    },
    {
      "tool": "rql-mutate",
      "input": {
        "query": "nodes | where name == \"EmptyRegion\" | call Bake()"
      },
      "expect": [
        "has no NavigationMesh to bake into"
      ],
      "expectFailure": true
    },
    {
      "tool": "rql-mutate",
      "input": {
        "query": "root | call AddChild(\"NavigationRegion2D\", \"NavRegion2D\")"
      },
      "expect": [
        "NavigationRegion2D#",
        "(NavRegion2D)"
      ]
    },
    {
      "tool": "rql-mutate",
      "input": {
        "query": "nodes | where name == \"NavRegion2D\" | set NavigationPolygon = {\"$type\": \"NavigationPolygon\"}"
      },
      "expect": [
        "NavigationPolygon#"
      ]
    },
    {
      "tool": "rql-mutate",
      "input": {
        "query": "nodes | where name == \"NavRegion2D\" | get NavigationPolygon | call AddOutline([\"(0, 0)\", \"(400, 0)\"])"
      },
      "expect": [
        "an outline needs at least 3 points (got 2)"
      ],
      "expectFailure": true
    },
    {
      "tool": "rql-mutate",
      "input": {
        "query": "nodes | where name == \"NavRegion2D\" | get NavigationPolygon | call AddOutline([\"(0, 0)\", \"(400, 0)\", \"(400, 300)\", \"(0, 300)\"])"
      },
      "expect": [
        "AddOutline("
      ]
    },
    {
      "tool": "rql-mutate",
      "input": {
        "query": "nodes | where name == \"NavRegion2D\" | call Bake()"
      },
      "expect": [
        "Bake("
      ]
    },
    {
      "tool": "rql-query",
      "input": {
        "query": "nodes | where name == \"NavRegion2D\" and polygonCount > 0 | select name NavigationPolygon.outlineCount"
      },
      "expect": [
        "1 result",
        "NavRegion2D|1"
      ]
    },
    {
      "tool": "rql-mutate",
      "input": {
        "query": "root | call AddChild(\"NavigationAgent2D\", \"Agent2D\")"
      },
      "expect": [
        "NavigationAgent2D#",
        "(Agent2D)"
      ]
    },
    {
      "tool": "rql-mutate",
      "input": {
        "query": "nodes | where name == \"Agent2D\" | set Radius = 12, MaxSpeed = 150"
      },
      "expect": [
        "MaxSpeed|"
      ]
    },
    {
      "tool": "rql-query",
      "input": {
        "query": "nodes | where $ is NavigationAgent2D | select name Radius MaxSpeed"
      },
      "expect": [
        "Agent2D|12|150"
      ]
    }
  ]
}

<Project>
  <!--
    TEMPORARY pre-release RQL feed (see the "TEMPORARY PRE-RELEASE PIN" note in Godot-MCP.csproj): prerelease-packages/
    holds com.IvanMurzak.Rql 0.3.0-dev.602ce7c, packed from RQL main 602ce7c. Every project under this repo (the addon,
    its tests, Godot-Tests, the extensions and their testbeds, the template, and the consumers CI scaffolds inside the
    checkout) restores from it in addition to its configured sources, nuget.config <clear/> included.
    Delete this file and prerelease-packages/ when the pins move back to a published nuget.org version.
  -->
  <PropertyGroup>
    <RestoreAdditionalProjectSources>$(RestoreAdditionalProjectSources);$(MSBuildThisFileDirectory)prerelease-packages</RestoreAdditionalProjectSources>
  </PropertyGroup>
</Project>

<Project Sdk="Godot.NET.Sdk/4.3.0">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <RootNamespace>com.IvanMurzak.Godot.MCP</RootNamespace>
    <AssemblyName>Godot-MCP</AssemblyName>
  </PropertyGroup>

  <!--
    Reused libraries (shared with Unity-MCP). Referenced via NuGet, never vendored/forked.
    Versions match the pins in Unity-MCP-Server (com.IvanMurzak.Unity.MCP.Server.csproj).
    com.IvanMurzak.McpPlugin is the client package; it transitively pulls
    McpPlugin.Common + ReflectorNet. ReflectorNet is also pinned explicitly to keep the
    version deterministic.
  -->
  <ItemGroup>
    <PackageReference Include="com.IvanMurzak.ReflectorNet" Version="5.5.1-dev.ec3702e" />
    <PackageReference Include="com.IvanMurzak.McpPlugin" Version="8.14.0-dev.71fa5c1" />
  </ItemGroup>

  <!--
    Editor-only packages: only `#if TOOLS` code uses them (RQL data layer, `script-execute` via Code-Exec + Roslyn),
    so Godot's export builds (ExportDebug / ExportRelease, the two configurations without TOOLS) leave them out and
    an exported game ships no Roslyn. Same rule the Godot SDK applies to GodotSharpEditor. The Condition sits on each
    element (after Version) so `godot-cli install-plugin` copies it per package; see docs/ARCHITECTURE.md.
    Code-Exec and Roslyn also go into exports when the game opts in to in-game `script-execute` with
    `GodotMcpCodeExecInGame=true` (plus the GODOT_MCP_CODE_EXEC_IN_GAME symbol, defined below for this project; a
    consumer csproj sets both). RQL never ships in a game.
    TEMPORARY PRE-RELEASE PINS (owner rule: between test waves RQL, Code-Exec, McpPlugin and ReflectorNet are not released; plugins consume
    their main commits): com.IvanMurzak.Rql 0.3.0-dev.544a247 is packed from RQL main 544a247, com.IvanMurzak.CodeExec + .Roslyn
    0.4.0-dev.2556a2f from Code-Exec main 2556a2f, com.IvanMurzak.McpPlugin (+ McpPlugin.Common, + McpPlugin.Server for the
    server build) 8.14.0-dev.71fa5c1 from MCP-Plugin-dotnet main 71fa5c1 (the McpPlugin pin above; same build as
    GameDev-MCP-Server) and com.IvanMurzak.ReflectorNet 5.5.1-dev.ec3702e from ReflectorNet main ec3702e (McpPlugin
    8.14.0-dev.71fa5c1 depends on it; the ReflectorNet pin above), all committed under prerelease-packages/; the
    repo-root Directory.Build.props adds that folder as a restore source for every project in this repo (core, tests,
    Godot-Tests, extensions, templates and the consumers CI scaffolds inside the checkout). Every csproj pin, the CLI
    fallback (cli/src/utils/addon-deps.ts) and the pin docs move together. At the cascade release: set the published
    version everywhere, delete prerelease-packages/ and Directory.Build.props.
  -->
  <PropertyGroup Condition="'$(GodotMcpCodeExecInGame)' == 'true'">
    <DefineConstants>$(DefineConstants);GODOT_MCP_CODE_EXEC_IN_GAME</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="com.IvanMurzak.Rql" Version="0.3.0-dev.544a247" Condition="'$(Configuration)' != 'ExportDebug' and '$(Configuration)' != 'ExportRelease'" />
    <PackageReference Include="com.IvanMurzak.CodeExec" Version="0.4.0-dev.2556a2f" Condition="'$(GodotMcpCodeExecInGame)' == 'true' or ('$(Configuration)' != 'ExportDebug' and '$(Configuration)' != 'ExportRelease')" />
    <PackageReference Include="com.IvanMurzak.CodeExec.Roslyn" Version="0.4.0-dev.2556a2f" Condition="'$(GodotMcpCodeExecInGame)' == 'true' or ('$(Configuration)' != 'ExportDebug' and '$(Configuration)' != 'ExportRelease')" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" Condition="'$(GodotMcpCodeExecInGame)' == 'true' or ('$(Configuration)' != 'ExportDebug' and '$(Configuration)' != 'ExportRelease')" />
  </ItemGroup>

  <!--
    The Godot.NET.Sdk auto-globs every *.cs under the project dir into THIS game assembly. Sibling
    projects that live in subfolders and own their own .csproj must be excluded here, otherwise their
    sources (which reference packages this game assembly does not, e.g. xUnit) get
    compiled into the game assembly and break the build:
      - Godot-MCP.Tests/   — the xUnit unit-test project.
      - Godot-Tests/       — the headless CI testbed project (owns Godot-Tests.csproj). It holds the
                             issue-#186 runtime-integration harness (Harness/RuntimeHarness.cs), whose
                             namespace + test-project assembly identity would leak into the addon assembly
                             and break the required `dotnet build (.NET 8)` gate (the sibling-project glob
                             trap — see conventions.md). The harness only ever compiles inside
                             Godot-Tests.csproj, driven by the Godot editor/CLI in the harness workflow.
  -->
  <ItemGroup>
    <Compile Remove="Godot-MCP.Tests/**/*.cs" />
    <Compile Remove="Godot-Tests/**/*.cs" />
    <!--
      Optional packages and fixtures must never leak through the root SDK glob. Never add .artifacts/ here:
      the SDK glob already skips dot-folders, and a Remove would strip the sources a source-only package
      (com.IvanMurzak.CodeExec.Roslyn) adds when a chain run's NUGET_PACKAGES cache sits under .artifacts/.
    -->
    <Compile Remove="extensions/**/*.cs;templates/**/*.cs;tests/**/*.cs" />
  </ItemGroup>

  <!--
    Shared extension catalog (single source of truth — see addons/godot_mcp/extensions.catalog.md). Embedded into the
    addon assembly so the pure-managed GodotExtensionRegistry can parse the REAL catalog at editor runtime with no
    res:// / filesystem dependency. The CLI mirrors the same JSON (cli/src/utils/extensions-catalog.ts), enforced
    byte-equal by a parity test. The LogicalName is fixed so GetManifestResourceStream resolves identically in the
    addon assembly AND the Godot-MCP.Tests assembly (which embeds the same file under the same name).
  -->
  <ItemGroup>
    <EmbeddedResource Include="addons/godot_mcp/extensions.catalog.json" LogicalName="Godot-MCP.extensions.catalog.json" />
  </ItemGroup>

</Project>
